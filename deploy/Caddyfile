# JANSETU: HTTPS in front of the API. Values come from deploy/.env through compose:
#   SITE_ADDRESS  server: "myjansetu.com, www.myjansetu.com"   laptop: "localhost"
#   DOMAIN        the main name; www.DOMAIN is redirected to it
#   ACME_EMAIL    Let's Encrypt expiry notices
# With a real domain Caddy gets and renews the certificate by itself (ports 80 and
# 443 must be open). With "localhost" it uses its own local certificate (curl -k).
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# The APK (6.3): deploy/apk/ on the host, published with scripts/publish_apk.py.
	# Only plain *.apk names are served; no folder listing.
	handle_path /download/* {
		@apk path_regexp ^/[A-Za-z0-9._-]+\.apk$
		handle @apk {
			root * /srv/apk
			header Content-Type application/vnd.android.package-archive
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			respond "Not found" 404
		}
	}

	# Later: the portal's static files go at the root (9.9).
	handle {
		respond "Not found" 404
	}

	log
}
