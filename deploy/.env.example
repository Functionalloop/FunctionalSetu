# Copy to deploy/.env and change the passwords. deploy/.env is git-ignored.

# --- PostgreSQL connection (used by docker compose and the Python scripts) ---
PGHOST=127.0.0.1
# Host port for the dev container. Not 5432/5433, which a native PostgreSQL
# or another project's container often already uses.
PGPORT=5442
POSTGRES_DB=jansetu

# Superuser inside the container. Only scripts/migrate.py uses it
# (the schema creates roles and extensions).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

# Roles created by 001_jansetu_schema.sql. migrate.py sets these passwords.
#   jansetu_owner: migrations, imports, seed (BYPASSRLS, never used by the API)
#   jansetu_app:   the API and worker (RLS applies)
JANSETU_OWNER_PASSWORD=change-me-owner
JANSETU_APP_PASSWORD=change-me-app

# --- Dev only: password given to every seeded test user (db/seed/seed.py) ---
SEED_USER_PASSWORD=Jansetu@123

# --- API (backend/) ---
# Signs access tokens. At least 32 random characters; changing it logs everyone out
# of their access tokens (refresh tokens keep working). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Browser origins allowed to call the API, comma-separated (portal dev server)
CORS_ORIGINS=http://localhost:5173

# --- Tests (backend/tests) ---
# pytest drops and re-creates its test database on every run. Two runs at the same time
# need two databases: run with TEST_RUNNER=<name> (e.g. claude, antigravity) to use
# jansetu_test_<name>; TEST_RUNNER wins over TEST_POSTGRES_DB. Only jansetu_test or
# jansetu_test_<name> is ever accepted.
TEST_POSTGRES_DB=jansetu_test
